{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/yaml-frag/inventory.schema.json",
  "title": "yaml-frag inventory",
  "description": "Structural schema for the inventory file. Cross-cutting rules (unique names, referenced groups exist, order preservation, output names existing in the project config) are enforced in inventory.py/render.py, not here. See README.md 'Validation'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": { "$ref": "#/$defs/variables" },
        "outputs": { "$ref": "#/$defs/outputFragments" }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/group" }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "variables": {
      "type": "object",
      "description": "Mapping of variable name to value. Each value is either a literal (scalar/list/mapping) or a `from:` source (secret/capture/literal). Source shapes are validated in sources.py, not here. See README.md 'Variable value sources'."
    },
    "fragmentList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "outputFragments": {
      "type": "object",
      "description": "Mapping of output name (declared in the project config's `outputs`) to this layer's ordered fragment contribution to that output. See README.md 'Fragment order'.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fragments": { "$ref": "#/$defs/fragmentList" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": { "$ref": "#/$defs/variables" },
        "outputs": { "$ref": "#/$defs/outputFragments" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": { "$ref": "#/$defs/outputFragments" },
        "variables": { "$ref": "#/$defs/variables" }
      }
    }
  }
}

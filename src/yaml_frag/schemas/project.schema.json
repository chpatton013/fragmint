{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/yaml-frag/project.schema.json",
  "title": "yaml-frag project configuration",
  "description": "Structural schema for yaml-frag.yaml. See README.md 'Project configuration' and 'Aggregate outputs'. Cross-cutting rules (e.g. that {target} appears in each output's path when rendering many targets, that --validator names exist, at most one output marked default: true, that an aggregate-scoped output's path must not contain {target} and may not be default: true, and that inventory-referenced output names exist here) are enforced in config.py/render.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "outputs"],
  "properties": {
    "version": { "const": 1 },
    "inventory": { "type": "string", "minLength": 1 },
    "fragments_dir": { "type": "string", "minLength": 1 },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/output" }
    },
    "validators": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/validator" }
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "template": { "type": ["string", "null"] },
        "schema": { "type": ["string", "null"] },
        "validators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "boolean" },
        "scope": { "enum": ["target", "aggregate"] }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    }
  }
}
